	},
	"dependencies": {
		"viem": "^2.37.3"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4",
		"wrangler": "^4.33.1"
	}
}
